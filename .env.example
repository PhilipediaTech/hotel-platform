# Copy to .env (never committed). Variables are added here as each ticket needs them.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Browser origins allowed by CORS (staff PWA and Astro site in local dev)
APP_ORIGIN=http://localhost:5173
SITE_ORIGIN=http://localhost:4321
# PostgreSQL (local native install). Tests refuse any TEST_DATABASE_URL not ending in _test.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_test
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_e2e
# Hashes session and email tokens: 32+ random characters, different per environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# Cookie domain for the `sid` cookie in production (e.g. .example.com). Leave unset locally.
# COOKIE_DOMAIN=
# Local-only password for every demo user created by `npm run seed` (<role>@demo.hotel.test).
# The seed refuses to run with NODE_ENV=production.
SEED_USER_PASSWORD=demo-SnSIUcMMzqrK
# Encrypts TOTP secrets at rest (AES-256-GCM): 32 random bytes as base64url, different per
# environment and never rotated without re-encrypting. The value below is refused in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Local file store (uploads in development), relative to the repository root. Default .data/files.
# LOCAL_FILES_DIR=.data/files
MFA_ENCRYPTION_KEY=ZGV2LW9ubHktbWZhLWtleS1jaGFuZ2UtbWUtMDAwMDA

# Encrypts guest ID numbers collected at check-in (AES-256-GCM): 32 random bytes as base64url,
# generated like MFA_ENCRYPTION_KEY and kept with it. Required in production; when unset outside
# production a fixed development key is used.
# ID_ENCRYPTION_KEY=

# Payment provider (T-070, ADR-021: Paystack). `fake` locally: its payment links open a
# development page that marks the payment paid. For Paystack, use a TEST secret key from your
# Paystack dashboard (Settings → API Keys): live keys are refused outside production.
PAYMENT_PROVIDER=fake
# PAYMENT_SECRET_KEY=sk_test_...

# WhatsApp (T-024, ADR-016: Meta Cloud API). `fake` locally: messages, approval codes
# included, are written to the worker's log. For Meta, follow the WhatsApp setup guide:
# the system-user token, the sender's phone number ID and the WhatsApp Business account ID
# from developers.facebook.com, and the app secret (signs Meta's status callbacks).
WHATSAPP_PROVIDER=fake
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_APP_SECRET=
# Any 16+ characters; typed into Meta when the webhook is set up (needs a public URL: staging).
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v23.0
# The demo owner's phone (`npm run seed`), so approval codes reach a real WhatsApp. Local only.
# SEED_OWNER_PHONE=+2348012345678

# Platform staff (T-100): comma-separated emails of the people who may open /platform (hotel
# groups, plans, invoices, modules, support sessions). They also need MFA turned on. Nobody can
# be made platform staff from inside the app.
# PLATFORM_ADMIN_EMAILS=you@example.com
