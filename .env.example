# Copy to .env (never committed). Variables are added here as each ticket needs them.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Browser origins allowed by CORS (staff PWA and Astro site in local dev)
APP_ORIGIN=http://localhost:5173
SITE_ORIGIN=http://localhost:4321
# PostgreSQL (local native install). Tests refuse any TEST_DATABASE_URL not ending in _test.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_test
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_e2e
