{
  "openapi": "3.1.0",
  "info": {
    "title": "Hotel Platform API",
    "version": "1",
    "description": "Staff app API. Money is a string of minor units with a currency; dates are `YYYY-MM-DD`; instants are ISO 8601 UTC. Errors use the `ErrorEnvelope`."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sid",
        "description": "Session cookie set by sign-in (httpOnly, Secure, SameSite=Lax)."
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "UNAUTHENTICATED",
                  "MFA_REQUIRED",
                  "SESSION_EXPIRED",
                  "FORBIDDEN",
                  "MODULE_DISABLED",
                  "PROPERTY_NOT_LIVE",
                  "NOT_FOUND",
                  "BOOKING_CONFLICT",
                  "VERSION_CONFLICT",
                  "STATE_TRANSITION_INVALID",
                  "IDEMPOTENCY_KEY_REUSED",
                  "PAYMENT_DUPLICATE",
                  "BUSINESS_DAY_CLOSED",
                  "SHIFT_NOT_OPEN",
                  "ROOM_NOT_READY",
                  "FOLIO_BALANCE_OUTSTANDING",
                  "CREDIT_LIMIT_EXCEEDED",
                  "AUDIT_IN_PROGRESS",
                  "RATE_BELOW_LIMIT",
                  "RESTRICTION_VIOLATED",
                  "APPROVAL_EXPIRED",
                  "RATE_LIMITED",
                  "INTERNAL"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {}
              },
              "requestId": {
                "type": "string",
                "example": "req_6f1c0c3f2b8a4e7d9a1b2c3d4e5f6a7b"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ],
        "description": "Every error response. Clients branch on `code`, never on `message`."
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "accepted"
        ],
        "description": "Sent if the account exists and qualifies; never says which."
      },
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Uuid"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "phone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mfaEnabled": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "phone",
              "mfaEnabled"
            ]
          },
          "session": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Uuid"
              },
              "sharedDevice": {
                "type": "boolean"
              },
              "mfaPassed": {
                "type": "boolean"
              },
              "pinSwitchAvailable": {
                "type": "boolean"
              },
              "expiresAt": {
                "$ref": "#/components/schemas/Instant"
              }
            },
            "required": [
              "id",
              "sharedDevice",
              "mfaPassed",
              "pinSwitchAvailable",
              "expiresAt"
            ]
          },
          "organisations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/components/schemas/Uuid"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ]
            }
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/components/schemas/Uuid"
                },
                "organisationId": {
                  "$ref": "#/components/schemas/Uuid"
                },
                "code": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "SETUP",
                    "LIVE",
                    "SUSPENDED",
                    "ARCHIVED"
                  ]
                },
                "timeZone": {
                  "type": "string"
                },
                "baseCurrency": {
                  "type": "string"
                },
                "locale": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "organisationId",
                "code",
                "name",
                "status",
                "timeZone",
                "baseCurrency",
                "locale"
              ]
            }
          },
          "memberships": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "organisationId": {
                  "$ref": "#/components/schemas/Uuid"
                },
                "propertyId": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Uuid"
                    },
                    {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  ]
                },
                "role": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "$ref": "#/components/schemas/Uuid"
                    },
                    "name": {
                      "type": "string"
                    },
                    "requiresMfa": {
                      "type": "boolean"
                    },
                    "permissions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "requiresMfa",
                    "permissions"
                  ]
                }
              },
              "required": [
                "organisationId",
                "propertyId",
                "role"
              ]
            }
          }
        },
        "required": [
          "user",
          "session",
          "organisations",
          "properties",
          "memberships"
        ],
        "description": "The signed-in user, their session and what they can access."
      },
      "Uuid": {
        "type": "string",
        "format": "uuid",
        "example": "0d0d0d0d-0000-4000-8000-000000000002"
      },
      "Instant": {
        "type": "string",
        "format": "date-time",
        "example": "2026-11-12T09:30:00Z"
      }
    },
    "parameters": {}
  },
  "paths": {
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "summary": "This API description (OpenAPI 3.1)",
        "tags": [
          "Meta"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {},
                  "description": "OpenAPI 3.1 document"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests: `RATE_LIMITED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Internal error: `INTERNAL`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/sign-up": {
      "post": {
        "operationId": "signUp",
        "summary": "Create an owner account, organisation and first property",
        "tags": [
          "Auth"
        ],
        "security": [],
        "description": "Creates the owner, their organisation (with role templates) and first property in SETUP, then emails a verification link. Answers the same way when the email is already registered, so it never reveals which addresses have accounts.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 200
                  },
                  "organisationName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "country": {
                    "type": "string",
                    "enum": [
                      "NG",
                      "GH",
                      "KE",
                      "ZA"
                    ]
                  },
                  "propertyName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "name",
                  "email",
                  "password",
                  "organisationName",
                  "country",
                  "propertyName"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "verificationSent": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "verificationSent"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request: `VALIDATION_ERROR`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests: `RATE_LIMITED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Internal error: `INTERNAL`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/email/verify": {
      "post": {
        "operationId": "verifyEmail",
        "summary": "Confirm an email address with the link token",
        "tags": [
          "Auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 200
                  }
                },
                "required": [
                  "token"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content"
          },
          "400": {
            "description": "Bad request: `VALIDATION_ERROR`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests: `RATE_LIMITED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Internal error: `INTERNAL`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/email/resend": {
      "post": {
        "operationId": "resendVerification",
        "summary": "Send a new verification link",
        "tags": [
          "Auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254
                  }
                },
                "required": [
