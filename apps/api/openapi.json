    "/auth/password/reset": {
      "post": {
        "operationId": "resetPassword",
        "summary": "Set a new password with the link token",
        "tags": [
          "Auth"
        ],
        "security": [],
        "description": "Signs out every session of the user and clears any lockout.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 200
                  },
                  "password": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 200
                  }
                },
                "required": [
