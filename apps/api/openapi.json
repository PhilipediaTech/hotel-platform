    "/me/sessions": {
      "get": {
        "operationId": "listMySessions",
        "summary": "My active sessions and devices",
        "tags": [
          "Me"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "$ref": "#/components/schemas/Uuid"
                          },
                          "current": {
                            "type": "boolean"
                          },
                          "sharedDevice": {
                            "type": "boolean"
                          },
                          "deviceLabel": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "userAgent": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "ip": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "createdAt": {
                            "$ref": "#/components/schemas/Instant"
                          },
                          "lastSeenAt": {
                            "$ref": "#/components/schemas/Instant"
                          }
                        },
                        "required": [
                          "id",
                          "current",
                          "sharedDevice",
                          "deviceLabel",
                          "userAgent",
                          "ip",
                          "createdAt",
                          "lastSeenAt"
                        ]
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Not signed in: `UNAUTHENTICATED`, `SESSION_EXPIRED`, `MFA_REQUIRED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests: `RATE_LIMITED`",
            "content": {
