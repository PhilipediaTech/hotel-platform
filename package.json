{
  "name": "hotel-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hotel management platform (PMS) — npm-workspaces monorepo",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/site",
    "packages/shared"
  ],
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
