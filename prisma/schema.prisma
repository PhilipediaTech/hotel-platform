// Hotel platform database schema. Source: spec tab 3 (Database Schema).
// Conventions: UUID ids; snake_case tables (plural) and columns via @@map/@map;
// money as BigInt minor units (*Minor); percentages as Int basis points (*Bps);
// DATE for business dates, TIMESTAMPTZ(6) for instants.
// Constraints Prisma can't express live in the migration SQL (see prisma/migrations).

generator client {
  provider               = "prisma-client"
  output                 = "../apps/api/src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Tenancy ─────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
}

enum FileScan {
  PENDING
  CLEAN
  INFECTED
}

enum PropertyStatus {
  SETUP
  LIVE
  SUSPENDED
  ARCHIVED

  @@map("property_status")
}

model Organisation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  legalName String?  @map("legal_name")
  country   String   @db.Char(2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  properties       Property[]
  roles            Role[]
  memberships      Membership[]
  departments      Department[]
  invitations      Invitation[]
  featureFlags     FeatureFlag[]
  auditEvents      AuditEvent[]
  domainEvents     DomainEvent[]
  approvalPolicies ApprovalPolicy[]
  approvalRequests ApprovalRequest[]
  files            FileObject[]
  roomTypes        RoomType[]
  rooms            Room[]
  ratePlans        RatePlan[]
  guests           Guest[]
  companies        Company[]
  reservations     Reservation[]

  @@map("organisations")
}

model Property {
  id              String         @id @default(uuid()) @db.Uuid
  organisationId  String         @map("organisation_id") @db.Uuid
  code            String
  name            String
  status          PropertyStatus @default(SETUP)
  timeZone        String         @default("Africa/Lagos") @map("time_zone")
  baseCurrency    String         @default("NGN") @map("base_currency") @db.Char(3)
  locale          String         @default("en-NG")
  address         Json
  phone           String?
  email           String?
  taxRegistration Json           @default("{}") @map("tax_registration")
  checkInTime     String         @default("14:00") @map("check_in_time")
  checkOutTime    String         @default("12:00") @map("check_out_time")
  nightAuditTime  String         @default("03:00") @map("night_audit_time")
  settings        Json           @default("{}")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation         Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  departments          Department[]
  memberships          Membership[]
  invitations          Invitation[]
  counters             PropertyCounter[]
  auditEvents          AuditEvent[]
  domainEvents         DomainEvent[]
  approvalPolicies     ApprovalPolicy[]
  approvalRequests     ApprovalRequest[]
  files                FileObject[]
  roomTypes            RoomType[]
  rooms                Room[]
  roomBlocks           RoomBlock[]
  revenueCodes         RevenueCode[]
  taxRules             TaxRule[]
  cancellationPolicies CancellationPolicy[]
  ratePlans            RatePlan[]
  rateDays             RateDay[]
  importJobs           ImportJob[]
  inventory            RoomTypeInventory[]
  quotes               Quote[]
  reservations         Reservation[]
  stays                Stay[]
  idDocuments          IdDocument[]
  businessDays         BusinessDay[]
  folios               Folio[]
  cashierShifts        CashierShift[]
  payments             Payment[]
  leakageAlerts        LeakageAlert[]

  @@unique([organisationId, code])
  // Target of composite foreign keys: a child row can only point at a property of its own organisation.
  @@unique([organisationId, id])
  @@map("properties")
}

model Department {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @map("organisation_id") @db.Uuid
  propertyId     String @map("property_id") @db.Uuid
  code           String
  name           String

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property     Property     @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict)
  memberships  Membership[]

  @@unique([propertyId, code])
  @@unique([propertyId, id])
  @@map("departments")
}

model FeatureFlag {
  organisationId String  @map("organisation_id") @db.Uuid
  module         String
  enabled        Boolean @default(false)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@id([organisationId, module])
  @@map("feature_flags")
}

/// Per-property sequences (confirmation numbers, folio numbers, task numbers).
/// Incremented with UPDATE … RETURNING inside the caller's transaction. Spec issue 6.
model PropertyCounter {
  propertyId String @map("property_id") @db.Uuid
  name       String
  value      Int    @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@id([propertyId, name])
  @@map("property_counters")
}

// ───────────────────────── Identity ─────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum SessionKind {
  USER
  DEVICE

  @@map("session_kind")
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET

  @@map("auth_token_purpose")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// Stored lower-case (CHECK in SQL).
  email           String?    @unique
  /// Set when the user proves they own `email` (verify link, password reset or invitation).
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  /// E.164, e.g. +2348000000000 (CHECK in SQL).
  phone           String?    @unique
  name            String
  passwordHash    String?    @map("password_hash")
  pinHash         String?    @map("pin_hash")
  mfaSecretEnc    Bytes?     @map("mfa_secret_enc")
  mfaEnabled      Boolean    @default(false) @map("mfa_enabled")
  /// Last TOTP time step accepted; a code is never accepted twice (RFC 6238 §5.2).
  mfaLastUsedStep BigInt?    @map("mfa_last_used_step")
  status          UserStatus @default(INVITED)
  failedLogins    Int        @default(0) @map("failed_logins")
  lockedUntil     DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions           Session[]
  memberships        Membership[]
  authTokens         AuthToken[]
  mfaRecoveryCodes   MfaRecoveryCode[]
  auditEvents        AuditEvent[]
  idempotencyKeys    IdempotencyKey[]
  approvalsRequested ApprovalRequest[]  @relation("RequestedBy")
  approvalsDecided   ApprovalRequest[]  @relation("DecidedBy")
  invitationsSent    Invitation[]       @relation("InvitedBy")
  filesUploaded      FileObject[]
  roomBlocksCreated  RoomBlock[]
  importJobs         ImportJob[]
  keysIssued         KeyIssue[]
  cardsSigned        RegistrationCard[]
  daysClosed         BusinessDay[]
  folioLinesPosted   FolioLine[]
  shifts             CashierShift[]     @relation("ShiftCashier")
  shiftsSignedOff    CashierShift[]     @relation("ShiftSignedOff")
  cashReceived       CashHandover[]
  leakageAlerts      LeakageAlert[]
  paymentsReceived   Payment[]
  invitationsClaimed Invitation[]       @relation("AcceptedBy")

  @@map("users")
}

model Session {
  id              String      @id @default(uuid()) @db.Uuid
  /// HMAC of the cookie token; the raw token is never stored.
  tokenHash       String      @unique @map("token_hash")
  userId          String      @map("user_id") @db.Uuid
  /// Set on a user's PIN session; points at the shared-device session a manager opened. Spec issue 4.
  parentSessionId String?     @map("parent_session_id") @db.Uuid
  mfaPassed       Boolean     @default(false) @map("mfa_passed")
  /// DEVICE = a manager-opened shared tablet (cookie `did` only, never accepted as `sid`). Spec issue 38.
  kind            SessionKind @default(USER)
  sharedDevice    Boolean     @default(false) @map("shared_device")
  deviceLabel     String?     @map("device_label")
  ip              String?
  userAgent       String?     @map("user_agent")
  expiresAt       DateTime    @map("expires_at") @db.Timestamptz(6)
  lastSeenAt      DateTime    @map("last_seen_at") @db.Timestamptz(6)
  revokedAt       DateTime?   @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  parentSession Session?  @relation("DeviceSession", fields: [parentSessionId], references: [id], onDelete: Cascade)
  childSessions Session[] @relation("DeviceSession")

  @@index([userId])
  @@index([parentSessionId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  permissions    String[] @default([])
  /// e.g. {"folio.discount":{"maxBps":1500}}
  limits         Json     @default("{}")
  requiresMfa    Boolean  @default(false) @map("requires_mfa")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organisationId, name])
  @@unique([organisationId, id])
  @@map("roles")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  /// null = organisation-wide
  propertyId     String?  @map("property_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property     Property?    @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict)
  role         Role         @relation(fields: [organisationId, roleId], references: [organisationId, id], onDelete: Restrict)
  department   Department?  @relation(fields: [propertyId, departmentId], references: [propertyId, id], onDelete: Restrict)

  /// Index is NULLS NOT DISTINCT in the migration SQL, so org-wide duplicates are rejected. Spec issue 5.
  @@unique([userId, organisationId, propertyId, roleId])
  @@index([propertyId])
  @@map("memberships")
}

/// Single-use tokens for email verification and password reset (hash only). Spec issue 1.
/// Single-use codes shown once when MFA is turned on, for a lost phone. Only HMACs are stored.
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// Staff invitation by email or phone to a role, optionally at one property. Spec issue 1.
/// Who changed what, written in the same transaction as the change (tab 2). Append-only:
/// a trigger refuses UPDATE and DELETE. Never holds secrets (the writer strips them).
model AuditEvent {
  id                BigInt   @id @default(autoincrement())
  organisationId    String   @map("organisation_id") @db.Uuid
  /// null = an organisation-level event (roles, sign-ins)
  propertyId        String?  @map("property_id") @db.Uuid
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  /// USER | SYSTEM | SUPPORT (CHECK in SQL)
  actorType         String   @map("actor_type")
  /// resource.verb, e.g. role.updated, user.roles_changed, auth.signed_in
  action            String
  entityType        String   @map("entity_type")
  entityId          String   @map("entity_id")
  before            Json?
  after             Json?
  reason            String?
  approvalRequestId String?  @map("approval_request_id") @db.Uuid
  requestId         String?  @map("request_id")
  ip                String?
  /// The "device" of tab 2 (spec issue 7).
  userAgent         String?  @map("user_agent")
  occurredAt        DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property     Property?    @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([propertyId, occurredAt])
  @@index([organisationId, occurredAt])
  @@index([entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  propertyId     String?   @map("property_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  email          String?
  phone          String?
  tokenHash      String    @unique @map("token_hash")
  invitedById    String    @map("invited_by_id") @db.Uuid
  acceptedById   String?   @map("accepted_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property     Property?    @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict)
  role         Role         @relation(fields: [organisationId, roleId], references: [organisationId, id], onDelete: Restrict)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("AcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@map("invitations")
}

// ───────────────────────── Infrastructure ─────────────────────────

/// Fixed-window request counters for the rate limiter ("stored in PostgreSQL", tab 2). Spec issue 2.
model RateLimitHit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_hits")
}

/// Idempotency-Key store (tab 2 "Idempotency", T-020): one row per user and key for 48 hours.
/// responseStatus is null while the first request is still running.
model IdempotencyKey {
  userId         String   @map("user_id") @db.Uuid
  key            String
  method         String
  path           String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Outbox (tab 2 "Audit, outbox and jobs", ADR-012; T-021): written in the transaction of the
/// change, then published by the worker to each handler as a pg-boss job.
model DomainEvent {
  id             BigInt       @id @default(autoincrement())
  organisationId String       @map("organisation_id") @db.Uuid
  propertyId     String?      @map("property_id") @db.Uuid
  type           String
  payload        Json
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property       Property?    @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict)

  @@index([publishedAt])
  @@map("domain_events")
}

/// Approval policy (tab 3; PRD M1-12; T-022): which protected action needs approval at a
/// property, above what threshold, decided by which roles, within how long.
model ApprovalPolicy {
  id              String       @id @default(uuid()) @db.Uuid
  organisationId  String       @map("organisation_id") @db.Uuid
  propertyId      String       @map("property_id") @db.Uuid
  /// A code from APPROVAL_ACTIONS (packages/shared/src/approvals.ts).
  action          String
  thresholdMinor  BigInt?      @map("threshold_minor")
  thresholdBps    Int?         @map("threshold_bps")
  approverRoleIds String[]     @map("approver_role_ids") @db.Uuid
  expiryMinutes   Int          @default(30) @map("expiry_minutes")
  active          Boolean      @default(true)
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property        Property     @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict)

  @@unique([propertyId, action])
  @@map("approval_policies")
}

/// Approval request (tab 3; PRD M1-09, M1-10; T-022): the exact payload of an action over
/// the caller's limit, waiting for a decision. OTP fields: spec issue 3 (approved).
model ApprovalRequest {
  id              String         @id @default(uuid()) @db.Uuid
  organisationId  String         @map("organisation_id") @db.Uuid
  propertyId      String         @map("property_id") @db.Uuid
  action          String
  payload         Json
  payloadHash     String         @map("payload_hash")
  amountMinor     BigInt?        @map("amount_minor")
  reason          String
  requestedById   String         @map("requested_by_id") @db.Uuid
  status          ApprovalStatus @default(PENDING)
  decidedById     String?        @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz(6)
  /// APP | WHATSAPP_OTP
  decisionChannel String?        @map("decision_channel")
  decisionNote    String?        @map("decision_note")
  resultRef       String?        @map("result_ref")
  otpHash         String?        @map("otp_hash")
  otpExpiresAt    DateTime?      @map("otp_expires_at") @db.Timestamptz(6)
  otpAttempts     Int            @default(0) @map("otp_attempts")
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organisation    Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property        Property       @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict)
  requestedBy     User           @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy       User?          @relation("DecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([propertyId, status])
  @@map("approval_requests")
}

/// Stored file (tab 3; tab 2 "Files"; T-023). The row is created with the upload link; the
/// worker scans the uploaded object and marks it CLEAN or INFECTED. Only CLEAN files get
/// download links. `entityType` is the file kind (FILE_KINDS in @hotel/shared).
model FileObject {
  id             String             @id @default(uuid()) @db.Uuid
  organisationId String             @map("organisation_id") @db.Uuid
  propertyId     String?            @map("property_id") @db.Uuid
  storageKey     String             @unique @map("storage_key")
  contentType    String             @map("content_type")
  sizeBytes      Int                @map("size_bytes")
  scan           FileScan           @default(PENDING)
  entityType     String?            @map("entity_type")
  entityId       String?            @map("entity_id")
  retentionClass String             @default("STANDARD") @map("retention_class")
  uploadedById   String             @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property       Property?          @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict)
  uploadedBy     User               @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  importJobs     ImportJob[]
  idDocuments    IdDocument[]
  cards          RegistrationCard[]

  @@index([propertyId, entityType, entityId])
  @@map("files")
}

// ───────────────────────── Rooms (M2-01–M2-03; T-031) ─────────────────────────

enum HkStatus {
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
  OUT_OF_ORDER
  OUT_OF_SERVICE

  @@map("hk_status")
}

enum BlockKind {
  OUT_OF_ORDER
  OUT_OF_SERVICE

  @@map("block_kind")
}

model RoomType {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  code           String
  name           String
  baseOccupancy  Int      @default(2) @map("base_occupancy")
  maxOccupancy   Int      @default(2) @map("max_occupancy")
  description    String?
  amenities      String[]
  /// Files of kind RoomType (FILE_KINDS); shown once the scan marks them CLEAN.
  photoFileIds   String[] @map("photo_file_ids") @db.Uuid
  sortOrder      Int      @default(0) @map("sort_order")
  active         Boolean  @default(true)

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property     Property            @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict)
  rooms        Room[]
  rateDays     RateDay[]
  inventory    RoomTypeInventory[]
  quotes       Quote[]
  stays        Stay[]

  @@unique([propertyId, code])
  // Target of composite foreign keys: a room can only have a type of its own property.
  @@unique([propertyId, id])
  @@map("room_types")
}

/// A sellable room. qrToken is the unguessable token printed on the room's QR sticker
/// (fault reports, T-082). connectingRoomId points at another room of the same property;
/// both rooms point at each other.
model Room {
  id               String   @id @default(uuid()) @db.Uuid
  organisationId   String   @map("organisation_id") @db.Uuid
  propertyId       String   @map("property_id") @db.Uuid
  roomTypeId       String   @map("room_type_id") @db.Uuid
  number           String
  floor            String?
  building         String?
  features         String[]
  connectingRoomId String?  @map("connecting_room_id") @db.Uuid
  hkStatus         HkStatus @default(DIRTY) @map("hk_status")
  hkStatusAt       DateTime @default(now()) @map("hk_status_at") @db.Timestamptz(6)
  qrToken          String   @unique @map("qr_token")
  active           Boolean  @default(true)
  version          Int      @default(0)

  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property       Property         @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict)
  roomType       RoomType         @relation(fields: [propertyId, roomTypeId], references: [propertyId, id], onDelete: Restrict)
  // Same property is checked by the service (Prisma can't mix a required and an optional column in one relation).
  connectingRoom Room?            @relation("ConnectingRoom", fields: [connectingRoomId], references: [id], onDelete: SetNull)
  connectedFrom  Room[]           @relation("ConnectingRoom")
  blocks         RoomBlock[]
  stays          Stay[]
  allocations    RoomAllocation[]
  keyIssues      KeyIssue[]

  @@unique([propertyId, number])
  // Target of composite foreign keys: blocks and connecting rooms stay within the property.
  @@unique([propertyId, id])
  @@index([propertyId, roomTypeId])
  @@map("rooms")
}

/// Out-of-order or out-of-service period of a room, endDate exclusive. Unreleased blocks
/// of one room never overlap (exclusion constraint in the migration SQL).
model RoomBlock {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @map("property_id") @db.Uuid
  roomId      String    @map("room_id") @db.Uuid
  kind        BlockKind
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  reason      String
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt  DateTime? @map("released_at") @db.Timestamptz(6)

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room      Room     @relation(fields: [propertyId, roomId], references: [propertyId, id], onDelete: Restrict)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([propertyId, startDate])
  @@map("room_blocks")
}

// ───────────────────────── Revenue codes and taxes (M4-17; T-032) ─────────────────────────

enum RevenueGroup {
  ROOM
  FNB
  OTHER
  TAX
  SERVICE_CHARGE
  FX
  FEE

  @@map("revenue_group")
}

/// NET = rate × line net; NET_PLUS_PRIOR = rate × (net + taxes with a lower sequence).
enum TaxBasis {
  NET
  NET_PLUS_PRIOR

  @@map("tax_basis")
}

/// What a folio line is posted to. taxRuleIds are applied in TaxRuleVersion.sequence order;
/// TAX and SERVICE_CHARGE codes carry the tax lines themselves and have no taxes of their own.
model RevenueCode {
  id         String       @id @default(uuid()) @db.Uuid
  propertyId String       @map("property_id") @db.Uuid
  code       String
  name       String
  group      RevenueGroup
  taxRuleIds String[]     @map("tax_rule_ids") @db.Uuid
  active     Boolean      @default(true)

  property          Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  taxRules          TaxRule[]          @relation("TaxLineCode")
  packageComponents PackageComponent[]
  folioLines        FolioLine[]
  routingRules      RoutingRule[]

  @@unique([propertyId, code])
  // Target of composite foreign keys: a tax rule posts to a code of its own property.
  @@unique([propertyId, id])
  @@map("revenue_codes")
}

/// A tax or service charge ("VAT", "Lagos consumption tax", "Service charge"). Its rate,
/// basis, order and inclusiveness live in dated versions; lines store the version they used.
model TaxRule {
  id            String @id @default(uuid()) @db.Uuid
  propertyId    String @map("property_id") @db.Uuid
  name          String
  authority     String
  /// The code the tax line posts to.
  revenueCodeId String @map("revenue_code_id") @db.Uuid

  property    Property         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  revenueCode RevenueCode      @relation("TaxLineCode", fields: [propertyId, revenueCodeId], references: [propertyId, id], onDelete: Restrict)
  versions    TaxRuleVersion[]

  @@map("tax_rules")
}

/// Rate and stacking of a tax rule from effectiveFrom up to (not including) effectiveTo; the
/// newest version is open-ended. Versions never change once written (M4 rule 1).
model TaxRuleVersion {
  id            String    @id @default(uuid()) @db.Uuid
  taxRuleId     String    @map("tax_rule_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  rateBps       Int       @map("rate_bps")
  basis         TaxBasis  @default(NET)
  sequence      Int
  inclusive     Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  taxRule    TaxRule     @relation(fields: [taxRuleId], references: [id], onDelete: Restrict)
  folioLines FolioLine[]

  @@index([taxRuleId, effectiveFrom])
  @@map("tax_rule_versions")
}

// ───────────────────────── Rates and restrictions (M2-04–M2-08; T-033) ─────────────────────────

enum RatePlanKind {
  BAR
  DERIVED
  PACKAGE
  DAY_USE
  NEGOTIATED

  @@map("rate_plan_kind")
}

enum Guarantee {
  NONE
  DEPOSIT
  CARD_ON_FILE
  COMPANY

  @@map("guarantee")
}

/// rules: [{"daysBefore":2,"feeType":"NIGHTS","value":1}], noShowFee: {"feeType":"NIGHTS","value":1}.
model CancellationPolicy {
  id         String @id @default(uuid()) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  name       String
  rules      Json
  noShowFee  Json   @map("no_show_fee")

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  ratePlans RatePlan[]

  @@unique([propertyId, id])
  @@map("cancellation_policies")
}

/// A way of selling rooms. BAR prices are set per room type and date; DERIVED plans follow
/// their parent (derivationBps and/or derivationAmountMinor, rounded to roundingMinor, never
/// below floorMinor); PACKAGE and DAY_USE plans have prices of their own, or derive too.
model RatePlan {
  id                    String       @id @default(uuid()) @db.Uuid
  organisationId        String       @map("organisation_id") @db.Uuid
  propertyId            String       @map("property_id") @db.Uuid
  code                  String
  name                  String
  kind                  RatePlanKind
  parentRatePlanId      String?      @map("parent_rate_plan_id") @db.Uuid
  /// -1000 = 10% off the parent.
  derivationBps         Int?         @map("derivation_bps")
  derivationAmountMinor BigInt?      @map("derivation_amount_minor")
  /// Derived prices round to the nearest multiple (10000 = NGN 100).
  roundingMinor         BigInt       @default(10000) @map("rounding_minor")
  floorMinor            BigInt?      @map("floor_minor")
  mealPlan              String       @default("ROOM_ONLY") @map("meal_plan")
  cancellationPolicyId  String       @map("cancellation_policy_id") @db.Uuid
  guarantee             Guarantee    @default(NONE)
  currency              String       @db.Char(3)
  /// Offered on the booking engine and channels (channel availability).
  isPublic              Boolean      @default(false) @map("is_public")
  companyId             String?      @map("company_id") @db.Uuid
  dayUseMaxMinutes      Int?         @map("day_use_max_minutes")
  /// Empty = every room type.
  roomTypeIds           String[]     @map("room_type_ids") @db.Uuid
  active                Boolean      @default(true)
  version               Int          @default(0)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation       Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property           Property           @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict)
  cancellationPolicy CancellationPolicy @relation(fields: [propertyId, cancellationPolicyId], references: [propertyId, id], onDelete: Restrict)
  parent             RatePlan?          @relation("DerivedFrom", fields: [parentRatePlanId], references: [id], onDelete: Restrict)
  children           RatePlan[]         @relation("DerivedFrom")
  days               RateDay[]
  components         PackageComponent[]
  quotes             Quote[]
  stays              Stay[]

  @@unique([propertyId, code])
  @@unique([propertyId, id])
  @@map("rate_plans")
}

/// Price and restrictions of one plan, room type and night. amountMinor is null on DERIVED
/// plans (computed from the parent). ruleVersion goes up on every change; quotes store it.
model RateDay {
  propertyId        String   @map("property_id") @db.Uuid
  ratePlanId        String   @map("rate_plan_id") @db.Uuid
  roomTypeId        String   @map("room_type_id") @db.Uuid
  date              DateTime @db.Date
  amountMinor       BigInt?  @map("amount_minor")
  minStay           Int?     @map("min_stay")
  maxStay           Int?     @map("max_stay")
  closedToArrival   Boolean  @default(false) @map("closed_to_arrival")
  closedToDeparture Boolean  @default(false) @map("closed_to_departure")
  stopSell          Boolean  @default(false) @map("stop_sell")
  ruleVersion       Int      @default(1) @map("rule_version")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  ratePlan RatePlan @relation(fields: [propertyId, ratePlanId], references: [propertyId, id], onDelete: Restrict)
  roomType RoomType @relation(fields: [propertyId, roomTypeId], references: [propertyId, id], onDelete: Restrict)

  @@id([ratePlanId, roomTypeId, date])
  @@index([propertyId, date])
  @@map("rate_days")
}

/// Part of a package price posted to its own revenue code each night (breakfast, transfer);
/// the room line gets the rest (PRD M2 acceptance: the lines add up to the package price).
model PackageComponent {
  id            String  @id @default(uuid()) @db.Uuid
  ratePlanId    String  @map("rate_plan_id") @db.Uuid
  name          String
  revenueCodeId String  @map("revenue_code_id") @db.Uuid
  amountMinor   BigInt  @map("amount_minor")
  perPerson     Boolean @default(false) @map("per_person")

  ratePlan    RatePlan    @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  revenueCode RevenueCode @relation(fields: [revenueCodeId], references: [id], onDelete: Restrict)

  @@index([ratePlanId])
  @@map("package_components")
}

// ───────────────────────── Imports (M1-03; T-034) ─────────────────────────

/// One uploaded spreadsheet checked and, once the user confirms, applied. kind: ROOMS |
/// RATES (GUESTS | COMPANIES | BALANCES arrive with their tickets). status: VALIDATED (no
/// errors, can be applied) | FAILED (errors listed in report) | APPLIED. report holds the
/// errors, the counts and the checked rows that apply uses, so nothing is read twice.
model ImportJob {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  kind        String
  fileId      String   @map("file_id") @db.Uuid
  status      String
  report      Json
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  file      FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)
  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([propertyId, createdAt])
  @@map("import_jobs")
}

// ───────────────────────── Inventory (M2 rules 1–2, M2-09; T-040) ─────────────────────────

/// Rooms of one type on one date (tab 2 "Inventory and concurrency"). capacity = active
/// rooms of the type (out-of-service ones still count); outOfOrder = those with an
/// out-of-order block that day. Both are rebuilt from rooms and blocks; sold and held are
/// changed only by reservations, with a conditional update that never passes
/// capacity + overbookLimit (CHECK in the migration).
model RoomTypeInventory {
  propertyId    String   @map("property_id") @db.Uuid
  roomTypeId    String   @map("room_type_id") @db.Uuid
  date          DateTime @db.Date
  capacity      Int
  outOfOrder    Int      @default(0) @map("out_of_order")
  sold          Int      @default(0)
  held          Int      @default(0)
  overbookLimit Int      @default(0) @map("overbook_limit")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  roomType RoomType @relation(fields: [propertyId, roomTypeId], references: [propertyId, id], onDelete: Restrict)

  @@id([propertyId, roomTypeId, date])
  @@map("room_type_inventory")
}

// ───────────────────────── Quotes (M2 rule 4, M2-10; T-041) ─────────────────────────

/// A priced stay, kept for 30 minutes so a booking made from it charges exactly this
/// (M2 rule 4). nights: [{date, amountMinor, ruleVersion, ...}]; taxes: per tax rule, with
/// the versions used. Amounts are minor units as strings inside the JSON.
model Quote {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  ratePlanId String   @map("rate_plan_id") @db.Uuid
  roomTypeId String   @map("room_type_id") @db.Uuid
  arrival    DateTime @db.Date
  departure  DateTime @db.Date
  nights     Json
  taxes      Json
  totalMinor BigInt   @map("total_minor")
  currency   String   @db.Char(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  ratePlan RatePlan @relation(fields: [propertyId, ratePlanId], references: [propertyId, id], onDelete: Restrict)
  roomType RoomType @relation(fields: [propertyId, roomTypeId], references: [propertyId, id], onDelete: Restrict)

  stay Stay?

  @@index([propertyId, expiresAt])
  @@map("quotes")
}

// ───────────────────────── Guests and companies (M3-15, M3-18, M3-16 basic; T-043) ─────────────

enum CompanyKind {
  COMPANY
  TRAVEL_AGENT
  EVENT_CLIENT

  @@map("company_kind")
}

/// A guest of the organisation (shared by its properties). A merged duplicate keeps its row
/// with mergedIntoId set and is hidden from search (M3 rule: merge keeps the oldest profile).
/// vip, doNotRent and flagReason are shown only to roles with guest.flag (M3-18).
model Guest {
  id               String    @id @default(uuid()) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  email            String?
  phone            String?
  nationality      String?   @db.Char(2)
  preferences      Json      @default("{}")
  marketingConsent Boolean   @default(false) @map("marketing_consent")
  consentAt        DateTime? @map("consent_at") @db.Timestamptz(6)
  vip              Boolean   @default(false)
  doNotRent        Boolean   @default(false) @map("do_not_rent")
  flagReason       String?   @map("flag_reason")
  mergedIntoId     String?   @map("merged_into_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  mergedInto   Guest?        @relation("GuestMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom   Guest[]       @relation("GuestMerge")
  bookings     Reservation[] @relation("ReservationBooker")
  stays        Stay[]
  idDocuments  IdDocument[]
  folioWindows FolioWindow[]

  @@index([organisationId, phone])
  @@index([organisationId, email])
  @@index([organisationId, lastName])
  @@map("guests")
}

/// A company, travel agent or event client of the organisation. Basic in V1 (name, contacts,
/// tax ID); credit limits, terms, commission and billing instructions are used from V1.1.
model Company {
  id                  String      @id @default(uuid()) @db.Uuid
  organisationId      String      @map("organisation_id") @db.Uuid
  kind                CompanyKind
  name                String
  contacts            Json        @default("[]")
  taxId               String?     @map("tax_id")
  creditLimitMinor    BigInt?     @map("credit_limit_minor")
  paymentTermsDays    Int?        @map("payment_terms_days")
  commissionBps       Int?        @map("commission_bps")
  billingInstructions Json        @default("{}") @map("billing_instructions")
  active              Boolean     @default(true)

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  bookings     Reservation[] @relation("ReservationCompany")
  agentOf      Reservation[] @relation("ReservationAgent")
  folioWindows FolioWindow[]

  @@index([organisationId, name])
  @@map("companies")
}

// ───────────────────────── Reservations (M3-01–M3-05, M3 rules 1 and 8; T-042) ─────────────

enum ReservationStatus {
  ENQUIRY
  TENTATIVE
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
  CANCELLED

  @@map("reservation_status")
}

enum BookingSource {
  WALK_IN
  PHONE
  EMAIL
  WHATSAPP
  DIRECT
  OTA_MANUAL
  OTA_CHANNEL
  CORPORATE
  TRAVEL_AGENT

  @@map("booking_source")
}

/// A booking: one booker, one or more stays (one per room). Transitions follow the fixed
/// table in packages/shared (M3 rule 1). A TENTATIVE hold has holdExpiresAt (CHECK) and is
/// released by the hold-expiry job.
model Reservation {
  id             String            @id @default(uuid()) @db.Uuid
  organisationId String            @map("organisation_id") @db.Uuid
  propertyId     String            @map("property_id") @db.Uuid
  confirmationNo String            @map("confirmation_no")
  bookerGuestId  String            @map("booker_guest_id") @db.Uuid
  companyId      String?           @map("company_id") @db.Uuid
  travelAgentId  String?           @map("travel_agent_id") @db.Uuid
  source         BookingSource
  channelRef     String?           @map("channel_ref")
  status         ReservationStatus @default(CONFIRMED)
  guarantee      Guarantee         @default(NONE)
  holdExpiresAt  DateTime?         @map("hold_expires_at") @db.Timestamptz(6)
  notes          String?
  cancelReason   String?           @map("cancel_reason")
  cancelledAt    DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int               @default(0)

  organisation Organisation               @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property     Property                   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  booker       Guest                      @relation("ReservationBooker", fields: [bookerGuestId], references: [id], onDelete: Restrict)
  company      Company?                   @relation("ReservationCompany", fields: [companyId], references: [id], onDelete: Restrict)
  travelAgent  Company?                   @relation("ReservationAgent", fields: [travelAgentId], references: [id], onDelete: Restrict)
  stays        Stay[]
  history      ReservationStatusHistory[]
  folios       Folio[]
  payments     Payment[]

  @@unique([propertyId, confirmationNo])
  @@unique([propertyId, source, channelRef])
  @@unique([propertyId, id])
  @@index([propertyId, status])
  @@index([status, holdExpiresAt])
  @@index([bookerGuestId])
  @@map("reservations")
}

/// One room of a reservation, made from a quote (kept for its prices and taxes; a quote
/// makes one stay at most). folioId is set by folios (T-060), roomId by assignment (T-050).
model Stay {
  id            String            @id @default(uuid()) @db.Uuid
  propertyId    String            @map("property_id") @db.Uuid
  reservationId String            @map("reservation_id") @db.Uuid
  guestId       String            @map("guest_id") @db.Uuid
  roomTypeId    String            @map("room_type_id") @db.Uuid
  roomId        String?           @map("room_id") @db.Uuid
  ratePlanId    String            @map("rate_plan_id") @db.Uuid
  quoteId       String            @unique @map("quote_id") @db.Uuid
  arrival       DateTime          @db.Date
  departure     DateTime          @db.Date
  adults        Int               @default(1)
  children      Int               @default(0)
  status        ReservationStatus
  isDayUse      Boolean           @default(false) @map("is_day_use")
  dayUseStart   DateTime?         @map("day_use_start") @db.Timestamptz(6)
  dayUseEnd     DateTime?         @map("day_use_end") @db.Timestamptz(6)
  folioId       String?           @map("folio_id") @db.Uuid
  checkedInAt   DateTime?         @map("checked_in_at") @db.Timestamptz(6)
  checkedOutAt  DateTime?         @map("checked_out_at") @db.Timestamptz(6)
  version       Int               @default(0)

  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservation Reservation       @relation(fields: [propertyId, reservationId], references: [propertyId, id], onDelete: Restrict)
  guest       Guest             @relation(fields: [guestId], references: [id], onDelete: Restrict)
  roomType    RoomType          @relation(fields: [propertyId, roomTypeId], references: [propertyId, id], onDelete: Restrict)
  room        Room?             @relation(fields: [propertyId, roomId], references: [propertyId, id], onDelete: Restrict)
  ratePlan    RatePlan          @relation(fields: [propertyId, ratePlanId], references: [propertyId, id], onDelete: Restrict)
  quote       Quote             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  folio       Folio?            @relation(fields: [propertyId, folioId], references: [propertyId, id], onDelete: Restrict)
  nights      StayNight[]
  allocations RoomAllocation[]
  keys        KeyIssue[]
  card        RegistrationCard?

  // Target of the composite foreign key from room allocations.
  @@unique([propertyId, id])
  @@index([propertyId, arrival])
  @@index([propertyId, departure])
  @@index([propertyId, status])
  @@index([reservationId])
  @@index([guestId])
  @@map("stays")
}

/// A room given to a stay for a date range, endDate exclusive (M3-07, M3-11; T-050). A move ends
/// one allocation and starts another; inactive rows are history. Active rows never overlap for a
/// room (exclusion constraint in the migration). A day-use stay (T-052) holds the room for its
/// hours: startsAt/endsAt set, dates = [its date, +1); day-use rows never overlap in time, and do
/// not collide with overnight rows (the same room is sold for the day and for the night).
model RoomAllocation {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  stayId     String    @map("stay_id") @db.Uuid
  roomId     String    @map("room_id") @db.Uuid
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  active     Boolean   @default(true)
  reason     String?
  startsAt   DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  stay Stay @relation(fields: [propertyId, stayId], references: [propertyId, id], onDelete: Restrict)
  room Room @relation(fields: [propertyId, roomId], references: [propertyId, id], onDelete: Restrict)

  @@index([propertyId, startDate])
  @@index([stayId])
  @@index([roomId])
  @@map("room_allocations")
}

/// A night of a stay as quoted: price, the plan that priced it and its rule version (M2 rule 4).
model StayNight {
  stayId      String   @map("stay_id") @db.Uuid
  date        DateTime @db.Date
  amountMinor BigInt   @map("amount_minor")
  ratePlanId  String   @map("rate_plan_id") @db.Uuid
  ruleVersion Int      @map("rule_version")

  stay Stay @relation(fields: [stayId], references: [id], onDelete: Cascade)

  @@id([stayId, date])
  @@map("stay_nights")
}

/// Every status change of a reservation (or one of its stays), append-only.
model ReservationStatusHistory {
  id            BigInt             @id @default(autoincrement())
  reservationId String             @map("reservation_id") @db.Uuid
  stayId        String?            @map("stay_id") @db.Uuid
  fromStatus    ReservationStatus? @map("from_status")
  toStatus      ReservationStatus  @map("to_status")
  reason        String?
  byUserId      String?            @map("by_user_id") @db.Uuid
  at            DateTime           @default(now()) @db.Timestamptz(6)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId, at])
  @@map("reservation_status_history")
}

// ───────────────────────── Check-in (M3-08, M3-19, M3 rule 6; T-051) ─────────────────────────

/// A guest's ID details as collected at check-in, only the fields the property requires
/// (M3 rule 6). The number is AES-256-GCM encrypted (ID_ENCRYPTION_KEY); the row and its scan
/// are deleted once `purgeAfter` has passed.
model IdDocument {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  guestId    String    @map("guest_id") @db.Uuid
  docType    String?   @map("doc_type")
  numberEnc  Bytes?    @map("number_enc")
  expiry     DateTime? @db.Date
  fileId     String?   @map("file_id") @db.Uuid
  purgeAfter DateTime  @map("purge_after") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  property          Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guest             Guest              @relation(fields: [guestId], references: [id], onDelete: Restrict)
  file              FileObject?        @relation(fields: [fileId], references: [id], onDelete: SetNull)
  registrationCards RegistrationCard[]

  @@index([propertyId, purgeAfter])
  @@index([guestId])
  @@map("id_documents")
}

/// Key cards issued for a stay (M3-19). Returns are logged at check-out.
model KeyIssue {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  stayId     String    @map("stay_id") @db.Uuid
  roomId     String    @map("room_id") @db.Uuid
  count      Int       @default(1)
  issuedById String    @map("issued_by_id") @db.Uuid
  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  returnedAt DateTime? @map("returned_at") @db.Timestamptz(6)

  stay     Stay @relation(fields: [propertyId, stayId], references: [propertyId, id], onDelete: Restrict)
  room     Room @relation(fields: [propertyId, roomId], references: [propertyId, id], onDelete: Restrict)
  issuedBy User @relation(fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([stayId])
  @@map("key_issues")
}

/// The registration card of a stay (M3-08): what the guest confirmed at check-in, without ID
/// data (that stays in id_documents). `fileId` is the on-screen signature; none = signed on
/// the printed card.
model RegistrationCard {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  stayId       String   @unique @map("stay_id") @db.Uuid
  idDocumentId String?  @map("id_document_id") @db.Uuid
  data         Json
  fileId       String?  @map("file_id") @db.Uuid
  signedAt     DateTime @map("signed_at") @db.Timestamptz(6)
  signedById   String?  @map("signed_by_id") @db.Uuid

  stay       Stay        @relation(fields: [propertyId, stayId], references: [propertyId, id], onDelete: Restrict)
  idDocument IdDocument? @relation(fields: [idDocumentId], references: [id], onDelete: SetNull)
  file       FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  signedBy   User?       @relation(fields: [signedById], references: [id], onDelete: SetNull)

  @@unique([propertyId, stayId])
  @@map("registration_cards")
}

enum DayStatus {
  OPEN
  AUDITING
  CLOSED

  @@map("day_status")
}

/// A property's business day (tab 3; T-054): the date the hotel is trading on. One is OPEN at a
/// time; night audit (T-073) closes it and opens the next. Until night audit exists, the day
/// rolls over when the property's local date changes. Days are only created once live.
model BusinessDay {
  propertyId String    @map("property_id") @db.Uuid
  date       DateTime  @db.Date
  status     DayStatus @default(OPEN)
  openedAt   DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(6)
  /// Null when closed by the automatic rollover.
  closedById String?   @map("closed_by_id") @db.Uuid

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  closedBy User?    @relation(fields: [closedById], references: [id], onDelete: SetNull)

  @@id([propertyId, date])
  @@map("business_days")
}

enum FolioKind {
  GUEST
  HOUSE
  PAYMASTER
  EVENT
  POS

  @@map("folio_kind")
}

enum FolioStatus {
  OPEN
  SETTLED
  TRANSFERRED
  CLOSED

  @@map("folio_status")
}

enum LineKind {
  CHARGE
  TAX
  DISCOUNT
  REVERSAL
  TRANSFER_IN
  TRANSFER_OUT
  DEPOSIT_APPLY
  WRITE_OFF

  @@map("line_kind")
}

/// A guest's bill (M4-01; tab 3; T-060). A guest folio opens at check-in, one per stay; house
/// and paymaster folios come with T-065. Its windows split who pays; lines are append-only.
model Folio {
  id               String      @id @default(uuid()) @db.Uuid
  organisationId   String      @map("organisation_id") @db.Uuid
  propertyId       String      @map("property_id") @db.Uuid
  number           String
  kind             FolioKind   @default(GUEST)
  reservationId    String?     @map("reservation_id") @db.Uuid
  name             String
  currency         String      @db.Char(3)
  status           FolioStatus @default(OPEN)
  creditLimitMinor BigInt?     @map("credit_limit_minor")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  version          Int         @default(0)

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservation  Reservation?  @relation(fields: [propertyId, reservationId], references: [propertyId, id], onDelete: Restrict)
  windows      FolioWindow[]
  lines        FolioLine[]
  routingRules RoutingRule[]
  stays        Stay[]
  payments     Payment[]

  @@unique([propertyId, number])
  @@unique([propertyId, id])
  @@index([reservationId])
  @@map("folios")
}

/// Who pays a share of a folio (M4-05): window 1 is the guest; others e.g. the company.
model FolioWindow {
  id           String  @id @default(uuid()) @db.Uuid
  folioId      String  @map("folio_id") @db.Uuid
  number       Int
  /// GUEST | COMPANY
  payerType    String  @map("payer_type")
  payerGuestId String? @map("payer_guest_id") @db.Uuid
  companyId    String? @map("company_id") @db.Uuid

  folio        Folio         @relation(fields: [folioId], references: [id], onDelete: Restrict)
  payerGuest   Guest?        @relation(fields: [payerGuestId], references: [id], onDelete: Restrict)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lines        FolioLine[]
  routingRules RoutingRule[]
  payments     Payment[]

  @@unique([folioId, number])
  @@map("folio_windows")
}

/// Sends a revenue group or code to a window (M4-05), e.g. room charges to the company.
model RoutingRule {
  id            String        @id @default(uuid()) @db.Uuid
  folioId       String        @map("folio_id") @db.Uuid
  revenueGroup  RevenueGroup? @map("revenue_group")
  revenueCodeId String?       @map("revenue_code_id") @db.Uuid
  windowId      String        @map("window_id") @db.Uuid

  folio       Folio        @relation(fields: [folioId], references: [id], onDelete: Restrict)
  window      FolioWindow  @relation(fields: [windowId], references: [id], onDelete: Restrict)
  revenueCode RevenueCode? @relation(fields: [revenueCodeId], references: [id], onDelete: Restrict)

  @@index([folioId])
  @@map("routing_rules")
}

/// A line on a folio (M4 rules 1–3): signed amount; a tax line points at its charge
/// (parentLineId) with the tax version it used; a correction is a reversal line pointing at the
/// original (reversesLineId). Never updated or deleted (trigger in the migration).
model FolioLine {
  id                String   @id @default(uuid()) @db.Uuid
  propertyId        String   @map("property_id") @db.Uuid
  folioId           String   @map("folio_id") @db.Uuid
  windowId          String   @map("window_id") @db.Uuid
  businessDate      DateTime @map("business_date") @db.Date
  postedAt          DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)
  kind              LineKind
  revenueCodeId     String   @map("revenue_code_id") @db.Uuid
  description       String
  quantity          Int      @default(1)
  unitAmountMinor   BigInt   @map("unit_amount_minor")
  amountMinor       BigInt   @map("amount_minor")
  currency          String   @db.Char(3)
  parentLineId      String?  @map("parent_line_id") @db.Uuid
  reversesLineId    String?  @unique @map("reverses_line_id") @db.Uuid
  taxRuleVersionId  String?  @map("tax_rule_version_id") @db.Uuid
  /// STAY_NIGHT | POS_ORDER | MINIBAR | EVENT | MANUAL
  sourceType        String?  @map("source_type")
  sourceId          String?  @map("source_id")
  postedById        String?  @map("posted_by_id") @db.Uuid
  /// The poster's open cashier shift, if any.
  shiftId           String?  @map("shift_id") @db.Uuid
  approvalRequestId String?  @map("approval_request_id") @db.Uuid
  reason            String?

  folio          Folio           @relation(fields: [propertyId, folioId], references: [propertyId, id], onDelete: Restrict)
  window         FolioWindow     @relation(fields: [windowId], references: [id], onDelete: Restrict)
  revenueCode    RevenueCode     @relation(fields: [propertyId, revenueCodeId], references: [propertyId, id], onDelete: Restrict)
  taxRuleVersion TaxRuleVersion? @relation(fields: [taxRuleVersionId], references: [id], onDelete: Restrict)
  postedBy       User?           @relation(fields: [postedById], references: [id], onDelete: SetNull)
  parentLine     FolioLine?      @relation("LineParent", fields: [parentLineId], references: [id], onDelete: Restrict)
  children       FolioLine[]     @relation("LineParent")
  reverses       FolioLine?      @relation("LineReversal", fields: [reversesLineId], references: [id], onDelete: Restrict)
  reversedBy     FolioLine?      @relation("LineReversal")
  shift          CashierShift?   @relation(fields: [propertyId, shiftId], references: [propertyId, id], onDelete: Restrict)

  @@index([folioId])
  @@index([propertyId, businessDate])
  @@map("folio_lines")
}

// ── Cashier shifts (M4-10–M4-12, M4 rule 4; tab 3; T-061) ─────────────────────────────

enum PayMethod {
  CASH
  BANK_TRANSFER
  POS_TERMINAL
  CARD_ONLINE
  VIRTUAL_ACCOUNT
  MOBILE_MONEY
  VOUCHER
  AR_TRANSFER

  @@map("pay_method")
}

enum ShiftStatus {
  OPEN
  CLOSING
  CLOSED

  @@map("shift_status")
}

/// A cashier's shift: opened with a counted float, closed by a blind count per method. Above
/// the variance tolerance it waits in CLOSING for a supervisor's sign-off.
model CashierShift {
  id            String      @id @default(uuid()) @db.Uuid
  propertyId    String      @map("property_id") @db.Uuid
  /// Null = the property's system shift for webhook payments (T-062).
  userId        String?     @map("user_id") @db.Uuid
  /// Outlet shifts come with POS (T-090s).
  outletId      String?     @map("outlet_id") @db.Uuid
  status        ShiftStatus @default(OPEN)
  floatMinor    BigInt      @default(0) @map("float_minor")
  openedAt      DateTime    @default(now()) @map("opened_at") @db.Timestamptz(6)
  /// When the count was given (the shift leaves OPEN).
  closedAt      DateTime?   @map("closed_at") @db.Timestamptz(6)
  signedOffById String?     @map("signed_off_by_id") @db.Uuid
  varianceNote  String?     @map("variance_note")

  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  user        User?          @relation("ShiftCashier", fields: [userId], references: [id], onDelete: Restrict)
  signedOffBy User?          @relation("ShiftSignedOff", fields: [signedOffById], references: [id], onDelete: SetNull)
  counts      CashCount[]
  handovers   CashHandover[]
  folioLines  FolioLine[]
  payments    Payment[]

  @@unique([propertyId, id])
  @@index([propertyId, status])
  @@map("cashier_shifts")
}

/// One method's blind count at close: expected (from the shift's float, handovers and
/// payments), counted, and the difference.
model CashCount {
  id            String    @id @default(uuid()) @db.Uuid
  shiftId       String    @map("shift_id") @db.Uuid
  method        PayMethod
  currency      String    @db.Char(3)
  expectedMinor BigInt    @map("expected_minor")
  countedMinor  BigInt    @map("counted_minor")
  varianceMinor BigInt    @map("variance_minor")

  shift CashierShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([shiftId, method, currency])
  @@map("cash_counts")
}

/// Cash leaving a shift's drawer: to another cashier (who confirms it into their open shift) or
/// to the safe (confirmed at once).
model CashHandover {
  id          String    @id @default(uuid()) @db.Uuid
  fromShiftId String    @map("from_shift_id") @db.Uuid
  /// Null = the safe.
  toUserId    String?   @map("to_user_id") @db.Uuid
  amountMinor BigInt    @map("amount_minor")
  currency    String    @db.Char(3)
  at          DateTime  @default(now()) @db.Timestamptz(6)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)

  fromShift CashierShift @relation(fields: [fromShiftId], references: [id], onDelete: Restrict)
  toUser    User?        @relation(fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([fromShiftId])
  @@index([toUserId])
  @@map("cash_handovers")
}

// ── Leakage (M-control; tab 3). Rules and review come later; T-061 raises shift variances. ──

enum Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL

  @@map("priority")
}

model LeakageAlert {
  id            String   @id @default(uuid()) @db.Uuid
  propertyId    String   @map("property_id") @db.Uuid
  ruleCode      String   @map("rule_code")
  businessDate  DateTime @map("business_date") @db.Date
  severity      Priority
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  subjectUserId String?  @map("subject_user_id") @db.Uuid
  evidence      Json
  dedupeKey     String   @map("dedupe_key")
  /// OPEN | REVIEWED
  status        String   @default("OPEN")
  raisedAt      DateTime @default(now()) @map("raised_at") @db.Timestamptz(6)

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  subjectUser User?    @relation(fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@unique([propertyId, dedupeKey])
  @@index([propertyId, status])
  @@map("leakage_alerts")
}

// ── Payments (M4-08, M4 rules 1, 4, 5; tab 3; T-062) ───────────────────────────────────

/// Money received (or, from T-072, refunded: negative). Append-only. Every payment belongs to
/// a cashier shift. Duplicate references are refused by two partial unique indexes in the
/// migration (open issue 19): (provider, external_ref) for providers, and (property, method,
/// external_ref) for manual payments (provider MANUAL).
model Payment {
  id                String    @id @default(uuid()) @db.Uuid
  propertyId        String    @map("property_id") @db.Uuid
  folioId           String?   @map("folio_id") @db.Uuid
  windowId          String?   @map("window_id") @db.Uuid
  /// Deposits before a folio exists (T-063).
  reservationId     String?   @map("reservation_id") @db.Uuid
  method            PayMethod
  /// Signed: refunds negative (T-072).
  amountMinor       BigInt    @map("amount_minor")
  currency          String    @db.Char(3)
  /// Foreign-currency payments (T-065).
  rateMicros        BigInt?   @map("rate_micros")
  baseAmountMinor   BigInt    @map("base_amount_minor")
  /// MANUAL for desk payments; the gateway's name for webhook payments.
  provider          String?
  externalRef       String?   @map("external_ref")
  businessDate      DateTime  @map("business_date") @db.Date
  shiftId           String    @map("shift_id") @db.Uuid
  receivedById      String?   @map("received_by_id") @db.Uuid
  refundsPaymentId  String?   @map("refunds_payment_id") @db.Uuid
  approvalRequestId String?   @map("approval_request_id") @db.Uuid
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  folio       Folio?       @relation(fields: [propertyId, folioId], references: [propertyId, id], onDelete: Restrict)
  window      FolioWindow? @relation(fields: [windowId], references: [id], onDelete: Restrict)
  reservation Reservation? @relation(fields: [propertyId, reservationId], references: [propertyId, id], onDelete: Restrict)
  shift       CashierShift @relation(fields: [propertyId, shiftId], references: [propertyId, id], onDelete: Restrict)
  receivedBy  User?        @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  refunds     Payment?     @relation("PaymentRefund", fields: [refundsPaymentId], references: [id], onDelete: Restrict)
  refundedBy  Payment[]    @relation("PaymentRefund")

  @@index([propertyId, businessDate])
  @@index([folioId])
  @@index([shiftId])
  @@map("payments")
}
